# ------------------------------------------------------------------
# Copy to .env (local) or add to your host's Environment Variables.
# VITE_* values are public (shipped to the browser). Everything else is
# server-only — never prefix secrets with VITE_.
# ------------------------------------------------------------------

# --- Backend connection (Supabase → Project Settings → API) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Optional — only for legacy admin helpers; the main flows work without it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site address (used in every email link) ---
VITE_APP_URL=https://your-helpdesk.example.com

# --- Organisation branding ---
VITE_ORG_NAME=SITA
VITE_ORG_SHORT_NAME=SITA
VITE_ORG_PRODUCT_NAME=Asset Management & Help Desk
VITE_ORG_HELPDESK_NAME=SITA Help Desk
# Absolute URL or a file in /public, e.g. /sita-logo.png
VITE_ORG_LOGO_URL=/sita-logo.png
VITE_ORG_EMAIL_DOMAIN=sita.example.com
VITE_ORG_SERVICE_DESK_EMAIL=servicedesk@sita.example.com
VITE_ORG_FILE_PREFIX=sita
# Colour theme: "orange" (SITA) or "blue" (Tipp Focus, default)
VITE_ORG_THEME=orange

# --- Email (Resend: resend.com → API Keys, verify your sending domain) ---
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=SITA Help Desk <helpdesk@sita.example.com>
# Comma-separated mailboxes that receive every new-ticket alert (overrides VITE_ORG_SERVICE_DESK_EMAIL)
SERVICE_DESK_EMAILS=servicedesk@sita.example.com

# --- Password reset shared secret ---
# Any long random string (e.g. `openssl rand -hex 24`). Must match the
# 'mail_secret' row in public.app_secrets (see SETUP.md step 3).
APP_MAIL_SECRET=

# --- Leave empty outside Lovable (emails then go straight to Resend) ---
LOVABLE_API_KEY=
